  "cards": [
    {
      "dot": "amber",
      "title": "Status & scope",
      "items": [
        "Target architecture based on the README and sketch descriptions; business services have no implementation yet.",
        "Blocks represent logical responsibilities; deployment boundaries outside agent-core are not yet finalized.",
        "The sketches include Chat Client, Web App, Shop interaction, Pull Data, Raw Data, Data Mart, and Data MCP."
      ]
    },
    {
      "dot": "cyan",
      "title": "agent-core MVP",
      "items": [
        "Conversation API with polling; asynchronous worker; OpenAI Agents API; SQLite on a persistent volume.",
        "Knowledge–Memory MCP and mock Data MCP run within the same service; a real endpoint can replace the mock Data MCP.",
        "One orchestrator configuration per shop; separate sessions for each conversation and user."
      ]
    },
    {
      "dot": "rose",
      "title": "Integration & execution permissions",
      "items": [
        "Authentication, registration, and shop CRUD belong to components outside agent-core; the identity contract needs confirmation.",
        "The Shop interaction arrow represents the target flow from the README, rather than a defined integration API.",
        "Detect → Classify → Plan → Approve → Execute → Verify → Learn is the product direction; proactive monitoring and real shop actions are outside the MVP."
      ]
    },
    {
      "dot": "emerald",
      "title": "Monorepo deployment",
      "items": [
        "Existing pipeline: GitHub Actions → GHCR → CapRover.",
        "Proposed agent-core deployment: one replica, one application worker, port 8000, and a /data volume.",
        "Internal integrations use the cluster network and runtime URLs; deployment resources are not confirmed to exist."
      ]
    }
  ]
