# Mount the operator-owned JSON and PostgreSQL CA; populated files stay outside Git.
MCP_CONFIG_FILE=/run/secrets/shop-data-mcp.json
# Dataset definitions can be mounted and reviewed independently of secrets.
MCP_CATALOG_FILE=/run/config/catalog.json
PORT=8000
# Explicit self URL for internal agent traffic; use the app's cluster hostname in CapRover.
MCP_INTERNAL_URL=http://localhost:8000/mcp
# Set when refresh is enabled; ingestion_token in the secret config must match
# cronjob-server MCP_SERVICE_TOKEN. CapRover uses its private cluster hostname.
CRONJOB_SERVER_URL=http://localhost:8001
