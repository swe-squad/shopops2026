# Docker ships the non-secret development config and demo catalog at these paths.
# Custom operator-owned JSON can be mounted over them. Populate credentials outside Git.
MCP_CONFIG_FILE=/run/secrets/shop-data-mcp.json
MCP_CATALOG_FILE=/run/config/catalog.json
# Required with the bundled config; override matching fields in any config source.
# MCP_CONTROL_DSN=host=PRIVATE_HOST dbname=shopops user=mcp_control password=REPLACE sslmode=verify-full sslrootcert=/run/secrets/postgres-ca.crt
# MCP_MEMBERSHIP_DSN=host=PRIVATE_SOURCE_HOST dbname=source user=mcp_membership password=REPLACE sslmode=verify-full sslrootcert=/run/secrets/postgres-ca.crt
# MCP_SHOPS_JSON={"shopee-open-platform:1001":{"query_dsn":"host=PRIVATE_HOST dbname=shopops user=shop_shopee1001 password=REPLACE sslmode=verify-full sslrootcert=/run/secrets/postgres-ca.crt","datasets":["order_economics"]}}
# Alternatively, remove the two *_FILE variables and set JSON directly in CapRover:
# MCP_CONFIG_JSON=<complete JSON object based on config.example.json>
# MCP_CATALOG_JSON=<approved JSON object based on catalog.example.json>
# Choose FILE or JSON for each source, never both (even if one is empty).
# Mount the real PostgreSQL CA referenced by each DSN; it is not bundled.
PORT=8000
# Explicit self URL for internal agent traffic; use the app's cluster hostname in CapRover.
MCP_INTERNAL_URL=http://localhost:8000/mcp
# Set when refresh or cronjob CRUD is enabled. CapRover uses its private cluster hostname.
CRONJOB_SERVER_URL=http://localhost:8001
# Required for bundled cronjob scopes; overrides ingestion_token in the JSON.
# Must match cronjob-server MCP_SERVICE_TOKEN.
# INGESTION_TOKEN=<service credential supplied outside Git>
