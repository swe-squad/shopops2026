PORT=8000
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-at-runtime
POSTGRES_DB=postgres
POSTGRES_SSLMODE=prefer
MOCK_DATA_SERVER_URL=http://localhost:8000
SYNC_INTERVAL_SECONDS=0
## Optional MCP bridge (disabled when no service token is configured).
# Match shop-data-mcp's ingestion_token; provision the value outside source control.
MCP_SERVICE_TOKEN=
# Map trusted JWT subjects to current source user identities. Not an agent tool argument.
MCP_SUBJECT_USERS_JSON={}
