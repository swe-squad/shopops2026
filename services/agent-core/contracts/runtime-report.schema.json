        "finding": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Finding",
          "type": "string"
        }
      },
      "required": [
        "reference",
        "finding"
      ],
      "title": "KnowledgeFinding",
      "type": "object"
    },
    "Metrics": {
      "additionalProperties": false,
      "properties": {
        "start_date": {
          "title": "Start Date",
          "type": "string"
        },
        "end_date": {
          "title": "End Date",
          "type": "string"
        },
        "orders": {
          "minimum": 0,
          "title": "Orders",
          "type": "integer"
        },
        "returns": {
          "minimum": 0,
          "title": "Returns",
          "type": "integer"
        },
        "return_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Return Rate"
        },
        "sku": {
          "title": "Sku",
          "type": "string"
        },
        "timezone": {
          "title": "Timezone",
          "type": "string"
