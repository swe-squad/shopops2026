# CapRover agent-core-dev demo preset. Merge into App Configs; do not replace secrets.
# Keep existing OPENAI_API_KEY and MCP_TOKEN_SIGNING_KEY in runtime config.
# Set MCP_TOKEN_SIGNING_KEY to a generated secret of at least 32 bytes if absent.
# Preserve the current DATABASE_URL if an existing deployment uses another durable path.
APP_ENV=local
PORT=8000
AGENT_PROVIDER=openai_agents
AUTH_MODE=fixture
DATABASE_URL=sqlite:////data/agent-core.db
CONFIG_PATH=config/registry.shop-data.develop.example.json
DATA_MCP_MODE=remote
DATA_MCP_URL=http://srv-captain--shop-data-mcp-dev:8000/mcp
KNOWLEDGE_MEMORY_MCP_URL=http://127.0.0.1:8000/mcp/knowledge-memory
SHOP_DATA_MCP_URL=http://srv-captain--shop-data-mcp-dev:8000/mcp
SHOP_DATA_BINDINGS_PATH=config/shop-data-bindings.example.json
OPENAI_MODEL=gpt-6-astra
RUNTIME_BUNDLE_PATH=runtime-bundles
