# Consumer settings for shopops-chat-api-dev, documented by Agent Core.
# Keep the existing CHAT_DATA_PATH if it differs; retain SHOP_API_TOKEN for navigation.
CHAT_BACKEND=agent_core
CHAT_AUTH_MODE=demo_phone
APP_ENV=local
AGENT_CORE_URL=http://srv-captain--agent-core-dev:8000
AGENT_CORE_SHOP_ID=shop-a
AGENT_CORE_CONFIG_REVISION=returns-hosted-data-luna-dev-v1
SHOPOPS_API_URL=http://srv-captain--shopops-api-dev:8000
CHAT_DATA_PATH=/data/chat.sqlite3

# Server-owned routes keyed by public synthetic Core fixture credential.
# The original account keeps AGENT_CORE_SHOP_ID / AGENT_CORE_CONFIG_REVISION.
AGENT_CORE_DEMO_ROUTES_JSON={"local-demo-002":{"shop_id":"shop-demo-002","config_revision":"returns-hosted-data-luna-shop002-dev-v1"},"local-demo-003":{"shop_id":"shop-demo-003","config_revision":"returns-hosted-data-luna-shop003-dev-v1"},"local-demo-004":{"shop_id":"shop-demo-004","config_revision":"returns-hosted-data-luna-shop004-dev-v1"}}
