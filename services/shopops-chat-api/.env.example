PORT=8000
SHOP_API_TOKEN=
OPENAI_API_KEY=
OPENAI_ORCHESTRATOR_AGENT_ID=
CHAT_DATA_PATH=/data/chat.sqlite3

# Keep openai_agents/workspace_token for the existing direct-provider mode.
CHAT_BACKEND=openai_agents
CHAT_AUTH_MODE=workspace_token
# Core phone demo is permitted only in local/test.
APP_ENV=local
AGENT_CORE_URL=http://127.0.0.1:8002
AGENT_CORE_SHOP_ID=shop-a
AGENT_CORE_CONFIG_REVISION=returns-hosted-v1
SHOPOPS_API_URL=http://127.0.0.1:8000

# Test-only offline cross-service acceptance (requires Core private dependencies)
# AGENT_CORE_LOOPBACK=1
